{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event session_started --input stdin",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event prompt_submitted --input stdin",
            "timeout": 1
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event needs_input --input stdin",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event turn_completed --input stdin",
            "timeout": 1
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event turn_failed --input stdin",
            "timeout": 1
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "termielle-emit.exe --source <agent> --event session_ended --input stdin",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
